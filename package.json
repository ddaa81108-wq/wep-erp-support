{
  "name": "abdo-erp-local",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "start": "node src/server/main.ts",
    "build:web": "vite build && node scripts/verify-web-bundle.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude=src/client/apiClients/** --test-coverage-exclude=src/client/apiPaths.ts --test-coverage-exclude=src/client/apiTransport.ts --test-coverage-exclude=src/client/**/use*.ts --test-coverage-lines=85 --test-coverage-branches=65 --test-coverage-functions=85 --test tests/*.test.ts",
    "test:ui": "node tests/ui-smoke.ts",
    "test:settings-requests-ui": "node tests/settings-request-order-ui.ts",
    "test:ledger-focus-ui": "node tests/ledger-focus-ui.ts",
    "test:languages-ui": "node tests/languages-ui.ts",
    "test:readability": "node tests/readability-ui.ts",
    "test:auth-l01": "node tests/auth-l01-ui.ts",
    "test:report-closing-ui": "node tests/report-closing-ui.ts",
    "test:fitted-amount-ui": "node tests/fitted-amount-ui.ts",
    "test:restore": "node scripts/restore-drill.mjs",
    "lint": "eslint src tests scripts/load-test.mts scripts/backup-database.mjs scripts/verify-database.mjs scripts/verify-https.mjs scripts/restore-drill.mjs scripts/verify-web-bundle.mjs public/erp-push-sw.js scripts/generate-push-config.mjs",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "verify:toolchain": "pwsh -NoProfile -File scripts/verify-toolchain.ps1",
    "build:installer": "pwsh -NoProfile -File scripts/build-installer.ps1",
    "test:realtime": "node tests/realtime-ui.ts",
    "test:performance-ui": "node tests/performance-ui.ts",
    "test:collections-ui": "node tests/collections-presentation-ui.ts",
    "test:zero-review-ui": "node tests/customer-zero-review-ui.ts",
    "test:treasury-ui": "node tests/treasury-presentation-ui.ts",
    "test:push-ui": "node tests/browser-push-ui.ts",
    "test:notifications-ui": "node tests/notification-buttons-ui.ts",
    "test:monitor-ui": "node tests/database-monitor-ui.ts",
    "test:activity-ui": "node tests/database-activity-ui.ts",
    "test:load": "node scripts/load-test.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^10.3.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "web-push": "^3.6.7"
  }
}

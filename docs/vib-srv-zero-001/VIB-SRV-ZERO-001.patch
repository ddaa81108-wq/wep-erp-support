+      reader.id,
+      'companies.read',
+      new Date().toISOString(),
+    );
+    db.prepare('INSERT INTO user_permissions(user_id,permission,allowed,updated_at) VALUES(?,?,1,?)').run(
+      writer.id,
+      'companies.write',
+      new Date().toISOString(),
+    );
+    const company = (
+      createCustomer(
+        db,
+        admin,
+        { requestId: randomUUID(), name: 'شركة مسار', openingBalance: 0 },

# واجهة API الداخلية. أبقها دائمًا 127.0.0.1؛ الوصول عبر LAN يتم من بوابة HTTPS فقط.
ABDO_HOST=127.0.0.1
ABDO_PORT=4310
ABDO_DB_PATH=./var/abdo-erp.sqlite
ABDO_SESSION_HOURS=12
ABDO_COOKIE_SECURE=false
ABDO_GOOGLE_REGISTRATION_ORGANIZATION_ID=org-default

# Optional legacy internet gate; default false permits LAN use without internet.
ABDO_INTERNET_REQUIRED=false

# On the installed public server only; leave unset for isolated local previews.
# ABDO_PUBLIC_ORIGIN=https://vip2100.com
